/* V2 Elegant Marker Styles */
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    margin: 0;
    padding: 0;
}

.slide {
    width: 1080px;
    height: 1080px;
    background-color: {{ theme.bg }};
    position: relative;
    overflow: hidden;
    color: {{ theme.text_head|default('#2D3130') }};
}

.eyebrow {
    position: absolute;
    top: 90px;
    left: 0;
    right: 0;
    text-align: center;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 22px;
    letter-spacing: 0.25em;
    color: {{ theme.text_label|default('#2D3130') }};
    text-transform: uppercase;
}

.content {
    position: absolute;
    top: 260px;
    left: 120px;
    width: 840px;
    display: flex;
    flex-direction: column;
    gap: 40px;
    z-index: 10;
}

.content.centered {
    align-items: center;
    text-align: center;
    top: 220px;
}

.number-badge {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 55px;
    color: {{ theme.text_head|default('#2D3130') }};
    position: relative;
    display: inline-block;
    margin-bottom: 20px;
}

.marker-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 180%;
    height: 160%;
    z-index: 0;
    pointer-events: none;
}

.headline {
    font-family: 'Instrument Serif', serif;
    font-size: 135px;
    line-height: 1.05;
    font-weight: 400;
    color: {{ theme.text_head|default('#2D3130') }};
    position: relative;
    z-index: 10;
}

.headline.smaller {
    font-size: 110px;
    margin-bottom: 10px;
}

.marker-text {
    position: relative;
    display: inline-block;
}

.marker-text svg {
    position: absolute;
    top: 55%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140%;
    height: 140%;
    z-index: -1;
}

.subhead {
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 32px;
    letter-spacing: 0.05em;
    color: {{ theme.text_body|default('#4A4E4D') }};
    text-transform: uppercase;
    margin-top: 20px;
}

.body-text {
    font-family: 'DM Sans', sans-serif;
    font-size: 42px;
    font-weight: 400;
    color: {{ theme.text_body|default('#4A4E4D') }};
    line-height: 1.5;
    text-align: left;
}

.content.centered .body-text {
    text-align: center;
}

ul.body-text {
    margin-left: 40px;
}
ul.body-text li {
    margin-bottom: 15px;
}

.pill-btn {
    position: absolute;
    bottom: 80px;
    right: 80px;
    background-color: {{ theme.accent }};
    border: 4px solid {{ theme.border_color|default('#111') }};
    border-radius: 60px;
    padding: 12px 40px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.pill-btn svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: {{ theme.border_color|default('#111') }};
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.watermark {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    opacity: 0.3;
    letter-spacing: 0.1em;
    color: {{ theme.text_head|default('#111') }};
}